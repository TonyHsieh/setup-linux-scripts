# ==============================================================================
# Justfile - Local Service Mesh Manager
# Usage: just -f <path-to-justfile> <command>  (or 'jl <command>')
# ==============================================================================

COMPOSE_CMD := if `command -v podman >/dev/null 2>&1 && echo 1 || echo 0` == "1" { "podman compose" } else { "docker compose" }
CONTAINER_CMD := if `command -v podman >/dev/null 2>&1 && echo 1 || echo 0` == "1" { "podman" } else { "docker" }

export LOCAL_SERVICES_DIR := justfile_directory()
export COMPOSE_PROJECT_NAME := "local-services"

default:
    @just --list -f {{justfile()}}

# Start all local container services (default core profile)
up:
    @if [ ! -f {{justfile_directory()}}/certs/local-cert.pem ]; then \
        echo "==> SSL certificates missing. Generating now..."; \
        just -f {{justfile()}} certs; \
    fi
    @echo "==> Starting local container mesh via {{COMPOSE_CMD}}..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml up -d

# Start ALL services including optional profiles (LLM, Books, Media)
up-all:
    @if [ ! -f {{justfile_directory()}}/certs/local-cert.pem ]; then \
        echo "==> SSL certificates missing. Generating now..."; \
        just -f {{justfile()}} certs; \
    fi
    @echo "==> Starting all local container services via {{COMPOSE_CMD}}..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml --profile all up -d

# Stop all local container services
down:
    @echo "==> Stopping local container mesh via {{COMPOSE_CMD}}..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml down

# Show status of local container services
status:
    @echo "==> Local container service status:"
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml ps

# View logs for local services (e.g. jl logs or jl logs traefik)
logs service="":
    @if [ -z "{{service}}" ]; then \
        {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml logs -f; \
    else \
        {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml logs -f {{service}}; \
    fi


# --- 🦙 Ollama Local LLM Inference Engine Tasks ---
# Start Ollama Local LLM service (https://ollama.localhost)
up-llm:
    @if [ ! -f {{justfile_directory()}}/certs/local-cert.pem ]; then \
        just -f {{justfile()}} certs; \
    fi
    @echo "==> Starting Ollama Local LLM service via {{COMPOSE_CMD}}..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml --profile llm up -d ollama
    @echo "👉 Ollama is available at http://localhost:11434 and https://ollama.localhost"

# Stop Ollama Local LLM service
down-llm:
    @echo "==> Stopping Ollama Local LLM service..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml stop ollama

# Pull a model into Ollama (e.g. jl llm-pull qwen2.5-coder:7b)
llm-pull model:
    @echo "==> Pulling model '{{model}}' into Ollama..."
    podman exec -it local-ollama ollama pull {{model}}

# Run interactive chat session with a model (e.g. jl llm-run qwen2.5-coder:1.5b)
llm-run model:
    @podman exec -it local-ollama ollama run {{model}}


# List downloaded models in Ollama
llm-list:
    @podman exec -i local-ollama ollama list

# Check Ollama status and available models
llm-status:
    @curl -s http://localhost:11434/api/tags 2>/dev/null | jq -r '.models[]? | "\(.name) (\(.size / 1024 / 1024 | floor) MB)"' 2>/dev/null || echo "Ollama not running or no models pulled yet."

# --- 💬 Open WebUI Tasks ---
# Start Open WebUI and Ollama (https://chat.localhost)
up-webui:
    @if [ ! -f {{justfile_directory()}}/certs/local-cert.pem ]; then \
        just -f {{justfile()}} certs; \
    fi
    @echo "==> Ensuring Ollama and Open WebUI are running via {{COMPOSE_CMD}}..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml --profile llm --profile webui up -d ollama open-webui
    @echo "👉 Open WebUI is available at https://chat.localhost"

# Stop Open WebUI service
down-webui:
    @echo "==> Stopping Open WebUI..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml stop open-webui

# --- 📚 Kavita E-Book & Manga Server Tasks ---
# Start Kavita E-Book & Manga Server (https://kavita.localhost)
up-books:
    @if [ ! -f {{justfile_directory()}}/certs/local-cert.pem ]; then \
        just -f {{justfile()}} certs; \
    fi
    @mkdir -p ${BOOKS_DIR:-$HOME/Books}
    @echo "==> Starting Kavita E-Book server via {{COMPOSE_CMD}}..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml --profile books up -d kavita
    @echo "👉 Kavita is available at https://kavita.localhost (Library: ${BOOKS_DIR:-$HOME/Books})"

# Stop Kavita E-Book Server
down-books:
    @echo "==> Stopping Kavita..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml stop kavita

# --- 🎬 Plex Media Server Tasks ---
# Start Plex Media Server (https://plex.localhost)
up-media:
    @if [ ! -f {{justfile_directory()}}/certs/local-cert.pem ]; then \
        just -f {{justfile()}} certs; \
    fi
    @mkdir -p ${MEDIA_DIR:-$HOME/Media}
    @echo "==> Starting Plex Media Server via {{COMPOSE_CMD}}..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml --profile media up -d plex
    @echo "👉 Plex is available at https://plex.localhost and http://localhost:32400/web"

# Stop Plex Media Server
down-media:
    @echo "==> Stopping Plex..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml stop plex
 
# --- 🌐 Tailscale Private Mesh Ingress Tasks ---
# Start Tailscale remote mesh ingress (exposes dedicated services on port 443 with in-memory auth key)
up-remote:
    #!/usr/bin/env bash
    set -euo pipefail
    COMPOSE="{{COMPOSE_CMD}}"
    DIR="{{justfile_directory()}}"

    # 1. Ensure TS_MACHINE_ID exists in ~/.local/share/local-services/.env (without secrets)
    ENV_FILE="${HOME}/.local/share/local-services/.env"
    if [ ! -f "$ENV_FILE" ]; then
        mkdir -p "${HOME}/.local/share/local-services"
        if [[ "$(hostname 2>/dev/null)" =~ [Ee][Nn][Vv][Yy] ]]; then
            MID="envy"
        elif [[ "$(hostname 2>/dev/null)" =~ [Aa][Ss][Uu][Ss] ]]; then
            MID="asus"
        elif [[ "$(hostname 2>/dev/null)" =~ [Aa][Rr][Cc][Hh] ]]; then
            MID="arch"
        else
            MID="$(hostname -s 2>/dev/null | cut -d'-' -f1 | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]')"
            MID="${MID:-laptop}"
        fi
        echo "TS_MACHINE_ID=$MID" > "$ENV_FILE"
        chmod 600 "$ENV_FILE"
    fi

    # 2. Ephemerally decrypt TS_AUTHKEY into memory (never saved to disk)
    TS_AUTHKEY=""
    for d in "$DIR/.." "$HOME/setup-linux-scripts" "$HOME/_Projects/setup-linux-scripts"; do
        SECRET_FILE="$d/secrets/tailscale.enc.yaml"
        if [ -f "$SECRET_FILE" ]; then
            if [ -z "${SOPS_AGE_KEY_FILE:-}" ]; then
                if [ -f "${HOME}/.config/sops/age/keys.txt" ]; then
                    export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
                elif [ -f "${HOME}/.ssh/id_ed25519" ]; then
                    export SOPS_AGE_KEY_FILE="${HOME}/.ssh/id_ed25519"
                fi
            fi
            TS_AUTHKEY="$(sops --decrypt --extract '["tailscale"]["auth_key"]' "$SECRET_FILE" 2>/dev/null || true)"
            if [ -n "$TS_AUTHKEY" ]; then
                break
            fi
        fi
    done

    echo "==> Starting Tailscale remote ingress nodes via $COMPOSE (in-memory auth key)..."
    TS_AUTHKEY="$TS_AUTHKEY" $COMPOSE -f "$DIR/docker-compose.yml" --profile remote up -d
    unset TS_AUTHKEY

    echo ""
    echo "👉 Tailscale remote containers are running!"
    sleep 3
    just -f "{{justfile()}}" remote-info

# Verify SOPS decryption with host SSH key and sanitize local .env (zero plaintext secrets)
sync-auth-key:
    #!/usr/bin/env bash
    for d in "{{justfile_directory()}}/.." "$HOME/setup-linux-scripts" "$HOME/_Projects/setup-linux-scripts"; do
        if [ -x "$d/scripts/sync-tailscale-key.sh" ]; then
            exec "$d/scripts/sync-tailscale-key.sh"
        fi
    done
    echo "⚠️ scripts/sync-tailscale-key.sh not found." >&2
    exit 1

# Rotate Tailscale auth key via Tailscale OAuth API and update encrypted secret
rotate-auth-key:
    #!/usr/bin/env bash
    for d in "{{justfile_directory()}}/.." "$HOME/setup-linux-scripts" "$HOME/_Projects/setup-linux-scripts"; do
        if [ -x "$d/scripts/rotate-tailscale-key.sh" ]; then
            exec "$d/scripts/rotate-tailscale-key.sh" "$@"
        fi
    done
    echo "⚠️ scripts/rotate-tailscale-key.sh not found." >&2
    exit 1

# Stop Tailscale remote mesh ingress
down-remote:
    @echo "==> Stopping Tailscale remote mesh ingress..."
    {{COMPOSE_CMD}} -f {{justfile_directory()}}/docker-compose.yml stop tailscale-pdf tailscale-chat tailscale-traefik tailscale-ollama tailscale-books tailscale-plex

# Check Tailscale mesh connection status across dedicated nodes
remote-status:
    @for node in local-tailscale-pdf local-tailscale-chat local-tailscale-traefik local-tailscale-ollama local-tailscale-books local-tailscale-plex; do \
        if {{CONTAINER_CMD}} ps -q -f name=$$node 2>/dev/null | grep -q .; then \
            echo "==> Node: $$node"; \
            {{CONTAINER_CMD}} exec $$node tailscale status; \
        fi \
    done

# View Tailscale Serve routing map and active HTTPS endpoints
remote-info:
    @echo "======================================================================"
    @echo "🌐 Tailscale Dedicated Remote Services (Standard HTTPS Port 443)"
    @echo "======================================================================"
    @SUFFIX=$({{CONTAINER_CMD}} exec local-tailscale-pdf tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty'); \
    PDF_NAME=$({{CONTAINER_CMD}} exec local-tailscale-pdf tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty'); PDF_NAME="${PDF_NAME%.}"; \
    CHAT_NAME=$({{CONTAINER_CMD}} exec local-tailscale-chat tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty'); CHAT_NAME="${CHAT_NAME%.}"; \
    TRAEFIK_NAME=$({{CONTAINER_CMD}} exec local-tailscale-traefik tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty'); TRAEFIK_NAME="${TRAEFIK_NAME%.}"; \
    OLLAMA_NAME=$({{CONTAINER_CMD}} exec local-tailscale-ollama tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty'); OLLAMA_NAME="${OLLAMA_NAME%.}"; \
    BOOKS_NAME=$({{CONTAINER_CMD}} exec local-tailscale-books tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty'); BOOKS_NAME="${BOOKS_NAME%.}"; \
    PLEX_NAME=$({{CONTAINER_CMD}} exec local-tailscale-plex tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty'); PLEX_NAME="${PLEX_NAME%.}"; \
    if [ -n "$SUFFIX" ]; then \
        echo "Tailnet Domain: $SUFFIX"; \
        echo ""; \
        echo "Dedicated HTTPS Endpoints (Reachable from any device on your Tailnet):"; \
        [ -n "$PDF_NAME" ] && echo "  • BentoPDF:               https://$PDF_NAME"; \
        [ -n "$CHAT_NAME" ] && echo "  • Open WebUI (AI Chat):   https://$CHAT_NAME"; \
        [ -n "$TRAEFIK_NAME" ] && echo "  • Traefik Dashboard:      https://$TRAEFIK_NAME"; \
        [ -n "$OLLAMA_NAME" ] && echo "  • Ollama LLM API:         https://$OLLAMA_NAME"; \
        [ -n "$BOOKS_NAME" ] && echo "  • Kavita E-Books:         https://$BOOKS_NAME"; \
        [ -n "$PLEX_NAME" ] && echo "  • Plex Media Server:      https://$PLEX_NAME"; \
    else \
        echo "⚠️ Tailscale services are starting up or not running."; \
        echo "Run 'jl up-remote' to start all dedicated endpoints."; \
    fi
    @echo "======================================================================"

# Show Tailscale login link if any container is waiting for authorization
remote-auth:
    @for node in local-tailscale-pdf local-tailscale-chat local-tailscale-traefik local-tailscale-ollama local-tailscale-books local-tailscale-plex; do \
        if {{CONTAINER_CMD}} ps -q -f name=$$node 2>/dev/null | grep -q .; then \
            if {{CONTAINER_CMD}} logs $$node 2>&1 | grep -q "To authenticate, visit:"; then \
                echo "==> Authorization required for $$node:"; \
                {{CONTAINER_CMD}} logs $$node 2>&1 | grep -A 2 "To authenticate, visit:" | tail -n 2; \
            fi \
        fi \
    done

# Generate / regenerate mkcert SSL certificates for *.localhost
certs:
    @echo "==> Generating wildcard SSL certificates for *.localhost..."
    @mkdir -p {{justfile_directory()}}/certs
    mkcert -cert-file {{justfile_directory()}}/certs/local-cert.pem -key-file {{justfile_directory()}}/certs/local-key.pem "*.localhost" "localhost" "pdf.localhost" "traefik.localhost" "ollama.localhost" "chat.localhost" "kavita.localhost" "plex.localhost" "127.0.0.1" "::1"
    @if podman ps -q -f name=traefik-ingress 2>/dev/null | grep -q .; then \
        echo "==> Reloading Traefik to apply updated certificates..."; \
        podman restart traefik-ingress >/dev/null 2>&1 || true; \
    fi


# Output OpenCode & Hermes MCP config snippets (on-demand containerized stdio)
mcp-info:
    @echo "======================================================================"
    @echo "👉 OpenCode MCP Configuration (~/.config/opencode/opencode.json):"
    @echo '  "mcp": {'
    @echo '    "puppeteer": {'
    @echo '      "type": "local",'
    @echo '      "command": ["podman", "run", "-i", "--rm", "--init", "docker.io/mcp/puppeteer:latest"]'
    @echo '    }'
    @echo '  }'
    @echo "======================================================================"
    @echo "👉 Hermes Agent MCP Configuration (~/.hermes/config.yaml):"
    @echo 'mcp_servers:'
    @echo '  puppeteer:'
    @echo '    command: "podman"'
    @echo '    args: ["run", "-i", "--rm", "--init", "docker.io/mcp/puppeteer:latest"]'
    @echo "======================================================================"
