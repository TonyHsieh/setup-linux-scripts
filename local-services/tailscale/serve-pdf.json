{
  "TCP": {
    "80": {
      "HTTP": true
    },
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:80": {
      "Handlers": {
        "/": {
          "Redirect": "301:https://${HOST}${REQUEST_URI}"
        }
      }
    },
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://bentopdf:8080"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:80": false,
    "${TS_CERT_DOMAIN}:443": false
  }
}
