# ==============================================================================
# Local Container Mesh - Environment Configuration
# ==============================================================================
# Machine identifier for Tailnet hostnames (e.g., asus, thinkpad, envy, dell, work)
# Endpoints will be: https://pdf-<TS_MACHINE_ID>.<tailnet>.ts.net
TS_MACHINE_ID=asus

# Tailscale Reusable Auth Key (from https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=
